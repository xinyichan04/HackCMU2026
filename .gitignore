.venv/
__pycache__/
*.pyc
.pytest_cache/
poc/models/
poc/archive/models/
*.mp4
*.mov
.context/
.DS_Store
# photo-mode reference photos are real people's likenesses: keep them local
poc/packs/**/*.jpg
poc/packs/**/*.jpeg
poc/packs/**/*.png
poc/archive/packs/**/*.jpg
poc/archive/packs/**/*.jpeg
poc/archive/packs/**/*.png
# reenactment filter (cindy-tryout)
sources/*
!sources/.gitkeep
!sources/README.md
results/
# generated face textures are real people's likenesses: keep them local
poc/textures/
poc/archive/textures/
# character models and the FBX/GLB they are built from: real people's likenesses,
# and large. Third-party test avatars re-fetch with poc/models3d/fetch.sh;
# member models rebuild from poc/models3d/sources/ via poc/tools/fbx_to_vrm.py.
poc/models3d/**/*.glb
poc/models3d/**/*.vrm
poc/models3d/**/*.fbx

# --- live_voice (RVC voice conversion) ---
# Vendored third-party code, not ours to version
external/
# Audio data and trained model artifacts (large, personal voice data)
data/raw/
data/processed/
models/
*.wav
*.mp3
*.m4a
*.pth
*.index

# the soundtrack index is generated from whatever audio is present locally or at
# deploy time — it lists copyrighted filenames and is environment-specific
poc/web/music/index.json
# ...except smoke-test sample audio, which is small and meant to be committed
!inference/test_audio/*.wav
# Conda
*.conda-lock
